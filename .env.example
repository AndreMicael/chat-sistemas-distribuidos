# NODE_LABEL vazio usa o nome do container para identificar instâncias.
# Opcional: copie este arquivo para .env ao usar Docker Compose.
# O valor 127.0.0.1 representa o próprio computador de quem executa.
CHAT_BIND=127.0.0.1
CHAT_PORT=4000
NODE_LABEL=

# Para permitir acesso pelo navegador de outro computador na mesma rede,
# altere CHAT_BIND para 0.0.0.0 e permita a porta no firewall.
# Esse acesso remoto ainda é um único servidor, não um cluster.
